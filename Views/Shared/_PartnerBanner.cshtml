<section class="partner-banner partner-banner--izotoff" aria-label="@SiteInfo.PartnerName">
    <div class="partner-banner__inner container-xl reveal">
        <p class="partner-banner__eyebrow">Также в Калининградской области</p>
        <h2 class="partner-banner__title">@SiteInfo.PartnerName</h2>
        <p class="partner-banner__lead">@SiteInfo.PartnerLead</p>
        <a href="@SiteInfo.PartnerUrl" class="btn btn-primary btn-lg" target="_blank" rel="noopener">@SiteInfo.PartnerCta</a>
    </div>
</section>
